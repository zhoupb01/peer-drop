{
  "name": "peer-drop",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "drop.clse-ai.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./data",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ],
  "ratelimits": [
    {
      "name": "API_WRITE_LIMIT",
      "namespace_id": "7300",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "ROOM_TTL_MS": "600000"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  }
}
